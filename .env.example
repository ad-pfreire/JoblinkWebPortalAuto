# Template. Copy it once per environment you test against:
#
#   cp .env.example .env            -> used by default (`npm test`)
#   cp .env.example .env.staging    -> used by `TEST_ENV=staging npm test`
#
# Every value below belongs to ONE environment, so each file is filled in
# independently - a staging run needs staging's own seed account, and its own
# Stripe/Mongo credentials if that environment uses different ones.
#
# Only this template is committed; every real .env* file is gitignored.
# On start, the suite prints which file it loaded and the BASE_URL it resolved,
# so check that line before a destructive run.

BASE_URL=https://your-app-url.example.com
TEST_EMAIL_USER=firstname.lastname
TEST_EMAIL_DOMAIN=@example.com
TEST_USERNAME=your_test_username
TEST_LOGIN_PASSWORD=ChangeMe123!
TEST_REGISTER_PASSWORD=ChangeMe123!

# Gmail App Password used to read the account-verification email over IMAP.
# Generate at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_IMAP_USER=firstname.lastname@example.com
GMAIL_IMAP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional. Only needed for the Teams x Subscription Test Clock
# investigation - see CLAUDE.md. A Stripe RESTRICTED test-mode key, scoped to
# ONLY: Test Clocks (Write), Customers (Read), Subscriptions (Read), Invoices
# (Read). Create one at https://dashboard.stripe.com (Test mode ON) ->
# Developers -> API keys -> Create restricted key. Never use the account's
# main secret key here.
STRIPE_TEST_RESTRICTED_KEY=rk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Only needed for the same investigation's MongoDB consistency
# check (Suite 4 of specs/teams-plan-gating-test-plan.md) - see CLAUDE.md.
# A READ-ONLY connection string for the database of THIS env's backend (point
# .env.staging at staging's, not pre-staging's). Prefer a dedicated,
# purpose-built read-only user over a shared team credential if you can create
# one - see CLAUDE.md for the current situation on this project. Never issue a
# write query with it regardless of what the underlying user may technically
# be able to do.
# Renamed from MONGODB_PRESTAGING_URI on 2026-09-11 - the old name was wrong
# for any other environment.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
